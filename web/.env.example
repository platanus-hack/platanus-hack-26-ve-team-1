# Copia este archivo a .env.local (ignorado por git) y ajústalo.

# "true": las funciones de src/api usan datos de demostración (sin backend).
#   Cuentas demo (contraseña "demo1234"):
#   ana@sisa.demo (24 años, cédula activa), luis@sisa.demo (16 años),
#   maria@sisa.demo (cédula revocada), emisor@sisa.demo, comercio@sisa.demo.
#   Las cuentas creadas con el registro mock sobreviven a recargas
#   (sessionStorage) y aceptan cualquier contraseña de 8+ caracteres.
# "false": se llama a la API real.
VITE_USE_MOCK=false

# Origen del backend (instancia externa), sin "/api" ni barra final. Ejemplo:
#   VITE_API_URL=https://api.sisa.example.com
# Se lee al hacer `npm run build` (queda dentro del bundle estático): hay que definirla en el
# panel de la CDN o del CI antes de compilar. No es un secreto. Vacía: se usa "/api" en el mismo origen.
VITE_API_URL=
