# Copia este archivo a .env.local y rellénalo. .env.local NO se sube a git.
# Para usarlo en la terminal:  set -a; . ./.env.local; set +a

# Postgres de Render (External Database URL). En el servicio de Render va la Internal URL.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST.virginia-postgres.render.com/NOMBRE_BD?sslmode=require"

# Claves privadas de los emisores: contenido de secrets/<nombre>.key.b64 (una línea, base64).
ISSUER_NACIONAL_KEY=
ISSUER_UNIVERSIDAD_KEY=

# Firma de sesiones (mínimo 16 caracteres). En Render se genera sola.
JWT_SECRET=

# Kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Solo local
PORT=8080
